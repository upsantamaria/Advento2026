        signTitle: `Sinal e oração – A água que nos recorda o Baptismo`,
        signDesc: `Na igreja, pode realizar-se uma aspersão da assembleia com água benta, recordando o Baptismo e a vida nova que recebemos em Cristo. Em família, cada pessoa pode fazer sobre si o sinal da cruz com água benta, se disponível, recordando o seu Baptismo e agradecendo o dom da fé.`,
        prayer: `Senhor Jesus, no dia do nosso Baptismo tornámo-nos filhos de Deus e membros da Tua Igreja. Obrigado pelo dom da fé e pela vida nova que recebemos. Renova em nós a força do Espírito Santo e ajuda-nos a viver como verdadeiros filhos de Deus, levando o Teu amor e a Tua Palavra a todos os que encontramos. Ámen.`
      }
    ];

    let appState = {
      selectedId: `advento-1`,
      seasonFilter: `all`,
      completedGestures: {},
      notes: {}
    };

    let searchQuery = ``;
    let saveTimer = null;

    function getSelectedIndex() {
      const idx = CAMPAIGN_DATA.findIndex(function(item) {
        return item.id === appState.selectedId;
      });
      return idx >= 0 ? idx : 0;
    }

    function getVisibleCelebrations() {
      if (appState.seasonFilter === `all`) {
        return CAMPAIGN_DATA;
      }
      return CAMPAIGN_DATA.filter(function(item) {
        return item.season === appState.seasonFilter;
      });
    }

    async function persistState() {
      if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === `function`) {
        try {
          await window.notebookAppApi.setAppState({
            selectedId: appState.selectedId,
            seasonFilter: appState.seasonFilter,
            completedGestures: appState.completedGestures,
            notes: appState.notes
          });
        } catch (err) {
          // Ignore transient host persistence errors silently
        }
      }
    }

    function selectCelebration(id, shouldScrollToDetail) {
      const exists = CAMPAIGN_DATA.some(function(item) { return item.id === id; });
      if (!exists) return;
      appState.selectedId = id;
      renderAll(true);
      persistState();
      if (shouldScrollToDetail) {
        const detailEl = document.getElementById(`detail-section`);
        if (detailEl) {
          detailEl.scrollIntoView({ behavior: `smooth`, block: `start` });
        }
      }
    }

    function stepCelebration(delta) {
      const visible = getVisibleCelebrations();
      if (!visible.length) return;
      let currentPos = visible.findIndex(function(item) {
        return item.id === appState.selectedId;
      });
      if (currentPos === -1) {
        currentPos = 0;
      } else {
        currentPos = Math.max(0, Math.min(visible.length - 1, currentPos + delta));
      }
      appState.selectedId = visible[currentPos].id;
      renderAll(true);
      persistState();
    }

    function setSeasonFilter(season) {
      appState.seasonFilter = season;
      const visible = getVisibleCelebrations();
      const stillVisible = visible.some(function(item) {
        return item.id === appState.selectedId;
      });
      if (!stillVisible && visible.length > 0) {
        appState.selectedId = visible[0].id;
      }
      renderAll(true);
      persistState();
    }

    function toggleGestureDone() {
      const id = appState.selectedId;
      appState.completedGestures[id] = !appState.completedGestures[id];
      renderAll(false);
      persistState();
    }

    function saveReflectionNote(value) {
      const id = appState.selectedId;
      appState.notes[id] = value;
      const feedbackEl = document.getElementById(`note-save-feedback`);
      if (feedbackEl) {
        feedbackEl.textContent = `A guardar registo…`;
      }
      if (saveTimer) clearTimeout(saveTimer);
      saveTimer = setTimeout(function() {
        persistState();
        if (feedbackEl) {
          feedbackEl.textContent = value.trim() ? `Registo guardado.` : `Registo limpo.`;
        }
      }, 260);
    }

    function filterOverviewTable(query) {
      searchQuery = String(query || ``).trim().toLowerCase();
      renderOverviewTable();
    }

    function copyTextField(fieldType) {
      const item = CAMPAIGN_DATA[getSelectedIndex()];
      if (!item) return;
      let textToCopy = ``;
      let successMsg = ``;
      if (fieldType === `scripture`) {
        textToCopy = `${item.title} — Texto a meditar: ${item.scripture}`;
        successMsg = `Referência bíblica copiada.`;
      } else {
        if (item.prayer) {
          textToCopy = `${item.title}\n${item.signTitle ? item.signTitle + '\n' : ''}${item.prayer}`;
          successMsg = `Oração copiada para a área de transferência.`;
        } else {
          textToCopy = `${item.title} — ${item.introLabel}: ${item.intro}`;
          successMsg = `Introdução à celebração copiada.`;
        }
      }
      const feedback = document.getElementById(`copy-feedback`);
      if (navigator.clipboard && typeof navigator.clipboard.writeText === `function`) {
        navigator.clipboard.writeText(textToCopy).then(function() {
          if (feedback) feedback.textContent = successMsg;
        }).catch(function() {
          if (feedback) feedback.textContent = `Selecione o texto para copiar manualmente.`;
        });
      } else {
        if (feedback) feedback.textContent = `Selecione o texto para copiar manualmente.`;
      }
    }

    function exportCampaignSummary() {
      const lines = [
        `CAMPANHA «ABRE O CORAÇÃO À PALAVRA» — ADVENTO E NATAL 2026/2027`,
        `Unidade Pastoral Santa Maria do Concelho de Penacova`,
        `================================================================`,
        ``
      ];
      CAMPAIGN_DATA.forEach(function(item) {
        const doneLabel = appState.completedGestures[item.id] ? `[VIVIDO]` : `[POR VIVER]`;
        lines.push(`${item.order}. ${item.title.toUpperCase()} (${item.seasonLabel}) ${doneLabel}`);
        lines.push(`   Tema: ${item.subtitle}`);
        lines.push(`   Texto a meditar: ${item.scripture}`);
        lines.push(`   Atitude a melhorar — ${item.attitudeTitle}: ${item.attitudeDesc}`);
        lines.push(`   Gesto da semana: ${item.gesture}`);
        lines.push(`   ${item.introLabel}: ${item.intro}`);
        if (item.signTitle) {
          lines.push(`   ${item.signTitle}: ${item.signDesc}`);
        }
        if (item.prayer) {
          lines.push(`   Oração: ${item.prayer}`);
        }
        const userNote = appState.notes[item.id];
        if (userNote && userNote.trim()) {
          lines.push(`   Registo pessoal/familiar: ${userNote.trim()}`);
        }
        lines.push(``);
      });

      const content = lines.join(`\n`);
      if (window.notebookAppApi && typeof window.notebookAppApi.triggerFileDownload === `function`) {
        window.notebookAppApi.triggerFileDownload({
          content: content,
          contentType: `text/plain`,
          encoding: `UTF-8`,
          filename: `campanha-abre-o-coracao-2026-penacova.txt`
        });
      } else {
        const blob = new Blob([content], { type: `text/plain;charset=utf-8` });
        const url = URL.createObjectURL(blob);
        const link = document.createElement(`a`);
        link.href = url;
        link.download = `campanha-abre-o-coracao-2026-penacova.txt`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      }
    }

    function resetProgressInline(btn) {
      if (!btn) return;
      if (btn.dataset.armed !== `true`) {
        btn.dataset.armed = `true`;
        const span = btn.querySelector(`span`);
        if (span) span.textContent = `Confirmar limpeza`;
        setTimeout(function() {
          if (btn.dataset.armed === `true`) {
            btn.dataset.armed = `false`;
            const s = btn.querySelector(`span`);
            if (s) s.textContent = `Limpar registos`;
          }
        }, 4000);
        return;
      }
      btn.dataset.armed = `false`;
      const span = btn.querySelector(`span`);
      if (span) span.textContent = `Limpar registos`;
      appState.completedGestures = {};
      appState.notes = {};
      renderAll(false);
      persistState();
    }

    function renderNavigationTabs() {
      const tabsContainer = document.getElementById(`celebration-tabs`);
      if (!tabsContainer) return;
      tabsContainer.innerHTML = ``;

      CAMPAIGN_DATA.forEach(function(item) {
        const isSelected = item.id === appState.selectedId;
        const isDone = Boolean(appState.completedGestures[item.id]);
        const isHidden = appState.seasonFilter !== `all` && item.season !== appState.seasonFilter;

        const btn = document.createElement(`button`);
        btn.type = `button`;
        btn.className = `celebration-tab` + (isHidden ? ` is-hidden` : ``);
        btn.setAttribute(`role`, `tab`);
        btn.setAttribute(`aria-selected`, isSelected ? `true` : `false`);
        btn.setAttribute(`data-id`, item.id);
        btn.onclick = function() {
          selectCelebration(item.id, false);
        };

        const metaRow = document.createElement(`div`);
        metaRow.className = `tab-meta-row`;

        const numSpan = document.createElement(`span`);
        numSpan.className = `tab-num`;
        numSpan.textContent = `0${item.order}`;
        metaRow.appendChild(numSpan);

        if (isDone) {
          const doneSpan = document.createElement(`span`);
          doneSpan.className = `tab-done-mark`;
          doneSpan.setAttribute(`title`, `Gesto vivido`);
          doneSpan.innerHTML = `<i data-lucide="check" aria-hidden="true"></i>`;
          metaRow.appendChild(doneSpan);
        }

        const titleSpan = document.createElement(`span`);
        titleSpan.className = `tab-title`;
        titleSpan.textContent = item.shortLabel;

        const guideSpan = document.createElement(`span`);
        guideSpan.className = `tab-guide`;
        guideSpan.textContent = item.guideShort;

        btn.appendChild(metaRow);
        btn.appendChild(titleSpan);
        btn.appendChild(guideSpan);
        tabsContainer.appendChild(btn);
      });

      const filterBtns = {
        all: document.getElementById(`filter-all`),
        Advento: document.getElementById(`filter-advento`),
        Natal: document.getElementById(`filter-natal`)
      };
      Object.keys(filterBtns).forEach(function(key) {
        const el = filterBtns[key];
        if (!el) return;
        if (appState.seasonFilter === key) {
          el.classList.add(`is-active`);
        } else {
          el.classList.remove(`is-active`);
        }
      });

      const visible = getVisibleCelebrations();
      const visibleIdx = visible.findIndex(function(c) { return c.id === appState.selectedId; });
      const prevBtn = document.getElementById(`btn-prev-celebration`);
      const nextBtn = document.getElementById(`btn-next-celebration`);
      if (prevBtn) prevBtn.disabled = visibleIdx <= 0;
      if (nextBtn) nextBtn.disabled = visibleIdx < 0 || visibleIdx >= visible.length - 1;

      const indicator = document.getElementById(`active-position-indicator`);
      const activeItem = CAMPAIGN_DATA[getSelectedIndex()];
      if (indicator && activeItem) {
        indicator.textContent = `Celebração ${activeItem.order} de ${CAMPAIGN_DATA.length} · ${activeItem.seasonLabel}`;
      }
    }

    function renderDetailView(animateHero) {
      const item = CAMPAIGN_DATA[getSelectedIndex()];
      if (!item) return;

      const heroEl = document.getElementById(`celebration-hero`);
      if (heroEl && animateHero) {
        heroEl.classList.remove(`fade-swap`);
        void heroEl.offsetWidth;
        heroEl.classList.add(`fade-swap`);
      }

      const isDone = Boolean(appState.completedGestures[item.id]);

      const seasonTag = document.getElementById(`detail-season-tag`);
      if (seasonTag) seasonTag.textContent = item.seasonLabel;

      const doneTag = document.getElementById(`detail-done-tag`);
      if (doneTag) doneTag.hidden = !isDone;

      const orderLabel = document.getElementById(`detail-order-label`);
      if (orderLabel) orderLabel.textContent = `Celebração 0${item.order} / 0${CAMPAIGN_DATA.length}`;

      const titleEl = document.getElementById(`detail-celebration-title`);
      if (titleEl) titleEl.textContent = item.title;

      const subEl = document.getElementById(`detail-celebration-subtitle`);
      if (subEl) subEl.textContent = item.subtitle;

      const introLabel = document.getElementById(`detail-intro-label`);
      if (introLabel) introLabel.textContent = item.introLabel;

      const introText = document.getElementById(`detail-intro-text`);
      if (introText) introText.textContent = item.intro;

      const scriptureEl = document.getElementById(`detail-scripture`);
      if (scriptureEl) scriptureEl.textContent = item.scripture;

      const seasonSubEl = document.getElementById(`detail-season-subline`);
      if (seasonSubEl) {
        seasonSubEl.textContent = item.seasonSubtitle ? item.seasonSubtitle : `Tempo do Advento — Preparação do coração`;
      }

      const attTitleEl = document.getElementById(`detail-attitude-title`);
      if (attTitleEl) attTitleEl.textContent = item.attitudeTitle;

      const attDescEl = document.getElementById(`detail-attitude-desc`);
      if (attDescEl) attDescEl.textContent = item.attitudeDesc;

      const gestureEl = document.getElementById(`detail-gesture-text`);
      if (gestureEl) gestureEl.textContent = item.gesture;

      const toggleBtn = document.getElementById(`btn-toggle-gesture`);
      const toggleText = document.getElementById(`btn-toggle-gesture-text`);
      const statusNote = document.getElementById(`gesture-status-note`);
      if (toggleBtn && toggleText && statusNote) {
        if (isDone) {
          toggleBtn.className = `btn btn-positive-active`;
          toggleText.textContent = `Gesto vivido esta semana`;
          statusNote.textContent = `Assinalado como concluído`;
          statusNote.className = `status-note is-positive`;
        } else {
          toggleBtn.className = `btn btn-primary`;
          toggleText.textContent = `Marcar gesto como vivido`;
          statusNote.textContent = `Por viver esta semana`;
          statusNote.className = `status-note`;
        }
      }

      const signContainer = document.getElementById(`detail-sign-container`);
      const signTitle = document.getElementById(`detail-sign-title`);
      const signDesc = document.getElementById(`detail-sign-desc`);
      if (signContainer && signTitle && signDesc) {
        if (item.signTitle && item.signDesc) {
          signContainer.hidden = false;
          signTitle.textContent = item.signTitle;
          signDesc.textContent = item.signDesc;
        } else {
          signContainer.hidden = true;
        }
      }

      const prayerContainer = document.getElementById(`detail-prayer-container`);
      const prayerText = document.getElementById(`detail-prayer-text`);
      const prayerEmpty = document.getElementById(`detail-prayer-empty`);
      const copyPrayerBtn = document.getElementById(`btn-copy-prayer`);
      if (prayerContainer && prayerText && prayerEmpty && copyPrayerBtn) {
        if (item.prayer) {
          prayerContainer.hidden = false;
          prayerEmpty.hidden = true;
          prayerText.textContent = item.prayer;
          const span = copyPrayerBtn.querySelector(`span`);
          if (span) span.textContent = `Copiar oração`;
        } else {
          prayerContainer.hidden = true;
          prayerEmpty.hidden = false;
          const span = copyPrayerBtn.querySelector(`span`);
          if (span) span.textContent = `Copiar introdução`;
        }
      }

      const copyFeedback = document.getElementById(`copy-feedback`);
      if (copyFeedback) copyFeedback.textContent = ``;

      const reflectionInput = document.getElementById(`reflection-input`);
      const reflectionLabel = document.getElementById(`reflection-label`);
      const noteFeedback = document.getElementById(`note-save-feedback`);
      if (reflectionInput) {
        reflectionInput.value = appState.notes[item.id] || ``;
      }
      if (reflectionLabel) {
        reflectionLabel.textContent = `Registo concreto para ${item.shortLabel}`;
      }
      if (noteFeedback) {
        noteFeedback.textContent = ``;
      }
    }

    function renderHeaderStats() {
      const doneCount = CAMPAIGN_DATA.filter(function(item) {
        return Boolean(appState.completedGestures[item.id]);
      }).length;
      const countEl = document.getElementById(`header-progress-count`);
      const noteEl = document.getElementById(`header-progress-note`);
      if (countEl) countEl.textContent = `${doneCount} / ${CAMPAIGN_DATA.length}`;
      if (noteEl) {
        if (doneCount === 0) {
          noteEl.textContent = `Gestos semanais vividos`;
        } else if (doneCount === CAMPAIGN_DATA.length) {
          noteEl.textContent = `Todos os gestos da campanha concluídos`;
        } else {
          noteEl.textContent = `${doneCount} ${doneCount === 1 ? 'gesto assinalado' : 'gestos assinalados'}`;
        }
      }
    }

    function renderOverviewTable() {
      const tbody = document.getElementById(`overview-table-body`);
      if (!tbody) return;
      tbody.innerHTML = ``;

      const matches = CAMPAIGN_DATA.filter(function(item) {
        if (!searchQuery) return true;
        const haystack = [
          item.title,
          item.subtitle,
          item.guideShort,
          item.scripture,
          item.attitudeTitle,
          item.attitudeDesc,
          item.gesture,
          item.seasonLabel
        ].join(` `).toLowerCase();
        return haystack.indexOf(searchQuery) !== -1;
      });

      if (matches.length === 0) {
        const emptyRow = document.createElement(`tr`);
        const emptyCell = document.createElement(`td`);
        emptyCell.colSpan = 6;
        emptyCell.textContent = `Nenhuma celebração corresponde à pesquisa "${searchQuery}".`;
        emptyRow.appendChild(emptyCell);
        tbody.appendChild(emptyRow);
        return;
      }

      matches.forEach(function(item) {
        const tr = document.createElement(`tr`);
        if (item.id === appState.selectedId) {
          tr.className = `is-selected`;
        }
        tr.onclick = function() {
          selectCelebration(item.id, true);
        };

        const tdNum = document.createElement(`td`);
        tdNum.className = `col-num`;
        tdNum.textContent = `0${item.order}`;

        const tdTitle = document.createElement(`td`);
        tdTitle.className = `table-title-cell`;
        tdTitle.textContent = item.title;

        const tdGuide = document.createElement(`td`);
        tdGuide.textContent = item.guideShort;

        const tdScripture = document.createElement(`td`);
        tdScripture.className = `table-scripture-cell`;
        tdScripture.textContent = item.scripture;

        const tdAttitude = document.createElement(`td`);
        tdAttitude.textContent = item.attitudeTitle;

        const tdStatus = document.createElement(`td`);
        const isDone = Boolean(appState.completedGestures[item.id]);
        const badge = document.createElement(`span`);
        badge.className = isDone ? `stamp-tag stamp-tag-green` : `stamp-tag`;
        badge.textContent = isDone ? `Vivido` : `Por viver`;
        tdStatus.appendChild(badge);

        tr.appendChild(tdNum);
        tr.appendChild(tdTitle);
        tr.appendChild(tdGuide);
        tr.appendChild(tdScripture);
        tr.appendChild(tdAttitude);
        tr.appendChild(tdStatus);
        tbody.appendChild(tr);
      });
    }

    function renderAll(animateHero) {
      renderHeaderStats();
      renderNavigationTabs();
      renderDetailView(animateHero);
      renderOverviewTable();
      if (window.lucide && typeof window.lucide.createIcons === `function`) {
        window.lucide.createIcons();
      }
    }

    document.addEventListener(`keydown`, function(e) {
      const activeTag = document.activeElement ? document.activeElement.tagName : ``;
      if (activeTag === `INPUT` || activeTag === `TEXTAREA`) return;
      if (e.key === `ArrowLeft`) {
        stepCelebration(-1);
      } else if (e.key === `ArrowRight`) {
        stepCelebration(1);
      }
    });

    async function initApp() {
      if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === `function`) {
        try {
          const saved = await window.notebookAppApi.getAppState();
          if (saved && typeof saved === `object`) {
            if (saved.selectedId && CAMPAIGN_DATA.some(function(c) { return c.id === saved.selectedId; })) {
              appState.selectedId = saved.selectedId;
            }
            if (saved.seasonFilter) {
              appState.seasonFilter = saved.seasonFilter;
            }
            if (saved.completedGestures && typeof saved.completedGestures === `object`) {
              appState.completedGestures = saved.completedGestures;
            }
            if (saved.notes && typeof saved.notes === `object`) {
              appState.notes = saved.notes;
            }
          }
        } catch (err) {
          // Proceed with default state
        }
      }

      renderAll(false);

      if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === `function`) {
        window.notebookAppApi.notifyAppReady();
      }
    }

    initApp();
  </script>
</body>
</html>
