<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="artifact-type" content="dashboard">
  <meta name="design-style" content="charter">
  <title>«Abre o coração à Palavra» — Campanha de Advento 2026 | Unidade Pastoral Santa Maria de Penacova</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@1.43.0/dist/umd/lucide.min.js"></script>
  <style>
    :root {
      color-scheme: light;

      /* Page and surfaces (Charter) */
      --background: #f7f4ec;
      --surface-container-low: #fffdf8;
      --surface-container: #ece5d4;
      --surface-container-high: #e3dac4;

      /* Ink */
      --on-surface: #1c1f26;
      --on-surface-variant: #4f5360;

      /* Rules */
      --outline: #b08d57;
      --outline-variant: #d9cfb8;

      /* Accents */
      --primary: #14213d;
      --on-primary: #f7f4ec;
      --primary-container: #e3e6ee;
      --on-primary-container: #14213d;
      --secondary: #2d5a4a;
      --secondary-container: #e2ede8;
      --tertiary: #8a6a35;
      --error: #9b2c2c;
      --on-error: #f7f4ec;

      /* Data series */
      --data-1: #14213d;
      --data-2: #8a6a35;
      --data-3: #2d5a4a;
      --data-4: #5b7aa0;
      --data-context: #c2bba9;

      /* Fonts */
      --font-headline: 'Libre Caslon Text', serif;
      --font-body: 'Inter', sans-serif;
      --font-label: 'Inter', sans-serif;

      /* Shape (2px Charter discipline) */
      --rounded: 0.125rem;
      --rounded-lg: 0.125rem;
      --rounded-full: 0.125rem;

      /* Style effects */
      --brass-rule: 2px solid var(--outline);
      --brass-band-border: 3px solid var(--outline);
      --hairline: 1px solid var(--outline-variant);
      --leaf-underline: 0 1px 0 var(--outline-variant);
      --navy-brass-text: color-mix(in srgb, var(--outline) 78%, var(--on-primary));
      --navy-lede-text: color-mix(in srgb, var(--on-primary) 82%, var(--primary));
      --navy-subtle-border: color-mix(in srgb, var(--outline) 45%, var(--primary));
      --navy-subtle-fill: color-mix(in srgb, var(--on-primary) 8%, var(--primary));

      /* Semantic tokens */
      --positive: #2d5a4a;
      --warning: #8a6a35;
      --focus: #14213d;

      /* Type scale (Dashboard / Explorer) */
      --display-size: clamp(1.85rem, 1.4rem + 1.5vw, 2.65rem);
      --headline-size: clamp(1.375rem, 1.15rem + 0.75vw, 1.85rem);
      --subhead-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
      --body-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1rem);
      --label-size: 0.75rem;

      /* Spacing scale (4pt base) */
      --space-xs: 0.25rem;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2.5rem;
      --space-2xl: 4rem;
      --space-3xl: 6rem;

      /* Motion */
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
      --dur-micro: 120ms;
      --dur-short: 220ms;
      --dur-long: 420ms;
    }

    /* Base reset */
    *, *::before, *::after { box-sizing: border-box; }
    html, body { overflow-x: clip; margin: 0; padding: 0; }
    header { position: static !important; }

    body {
      background-color: var(--background);
      color: var(--on-surface);
      font-family: var(--font-body);
      font-size: var(--body-size);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    button, input, select, textarea {
      font-family: inherit;
    }

    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    .title-band :focus-visible {
      outline: 2px solid var(--on-primary);
      outline-offset: 2px;
    }

    /* Full-bleed Navy Title Band (Charter Treatment 1) */
    .title-band {
      background-color: var(--primary);
      color: var(--on-primary);
      border-bottom: var(--brass-band-border);
      padding-block: var(--space-xl);
      padding-inline: var(--space-lg);
    }

    .title-band-inner {
      max-width: 1200px;
      margin-inline: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-lg) var(--space-xl);
      align-items: center;
    }

    .brand-lockup {
      display: flex;
      align-items: center;
      gap: var(--space-lg);
      padding-bottom: var(--space-md);
      margin-bottom: var(--space-md);
      border-bottom: 1px solid var(--navy-subtle-border);
    }

    .pastoral-crest {
      width: 112px;
      height: auto;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pastoral-logo-img {
      width: 100%;
      height: auto;
      display: block;
      mix-blend-mode: screen;
      object-fit: contain;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .brand-kicker {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--navy-brass-text);
    }

    .brand-name {
      font-family: var(--font-headline);
      font-size: var(--subhead-size);
      font-weight: 400;
      color: var(--on-primary);
      line-height: 1.25;
    }

    .campaign-kicker {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--navy-brass-text);
      margin: 0 0 var(--space-xs);
    }

    .title-band h1 {
      font-family: var(--font-headline);
      font-weight: 400;
      font-size: var(--display-size);
      line-height: 1.1;
      letter-spacing: -0.01em;
      color: var(--on-primary);
      margin: 0 0 var(--space-sm);
    }

    .title-band .lede {
      color: var(--navy-lede-text);
      max-width: 65ch;
      margin: 0;
      line-height: 1.55;
    }

    .header-summary {
      background-color: var(--navy-subtle-fill);
      border: 1px solid var(--navy-subtle-border);
      border-top: var(--brass-rule);
      border-radius: var(--rounded);
      padding: var(--space-md) var(--space-lg);
      min-width: 240px;
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .header-stat-label {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--navy-brass-text);
    }

    .header-stat-value {
      font-family: var(--font-headline);
      font-weight: 400;
      font-size: var(--headline-size);
      font-variant-numeric: tabular-nums lining-nums;
      color: var(--on-primary);
      line-height: 1.1;
    }

    .header-stat-note {
      font-size: 0.875rem;
      color: var(--navy-lede-text);
    }

    /* Main Container */
    .page-grid {
      display: grid;
      gap: var(--space-xl);
      padding: var(--space-lg);
      max-width: 1200px;
      margin: 0 auto;
      overflow: hidden;
    }
    .page-grid * { min-width: 0; }

    /* Section Head (Charter Treatment 5) */
    .section-head {
      border-top: var(--brass-rule);
      padding-top: var(--space-md);
      border-bottom: var(--hairline);
      padding-bottom: var(--space-sm);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-md);
    }

    .section-head-titles {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .label-kicker {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--tertiary);
    }

    .section-head h2, .section-title {
      font-family: var(--font-headline);
      font-weight: 400;
      font-size: var(--headline-size);
      line-height: 1.18;
      margin: 0;
      color: var(--on-surface);
    }

    /* Navigation Strip */
    .nav-controls-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      margin-bottom: var(--space-md);
    }

    .season-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .step-arrows {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      min-height: 44px;
      padding: var(--space-sm) var(--space-md);
      border-radius: var(--rounded);
      font-family: var(--font-label);
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      cursor: pointer;
      transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
      text-decoration: none;
    }

    .btn-primary {
      background-color: var(--primary);
      color: var(--on-primary);
      border: 1px solid var(--primary);
    }
    .btn-primary:hover:not(:disabled) {
      background-color: color-mix(in srgb, var(--primary) 88%, var(--on-surface));
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--primary);
      border: 1px solid var(--primary);
    }
    .btn-secondary:hover:not(:disabled) {
      background-color: var(--primary-container);
    }

    .btn-subtle {
      background-color: var(--surface-container-low);
      color: var(--on-surface);
      border: 1px solid var(--outline-variant);
    }
    .btn-subtle:hover:not(:disabled) {
      background-color: var(--surface-container);
    }

    .btn.is-active {
      background-color: var(--primary);
      color: var(--on-primary);
      border-color: var(--primary);
    }

    .btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .btn-positive-active {
      background-color: var(--secondary);
      color: var(--on-primary);
      border: 1px solid var(--secondary);
    }
    .btn-positive-active:hover:not(:disabled) {
      background-color: color-mix(in srgb, var(--secondary) 88%, var(--on-surface));
    }

    /* 8-Celebration Selector Grid */
    .celebration-grid-nav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(132px, 100%), 1fr));
      gap: var(--space-sm);
    }

    .celebration-tab {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-xs);
      min-height: 76px;
      padding: var(--space-sm) var(--space-md);
      background-color: var(--surface-container-low);
      border: 1px solid var(--outline-variant);
      border-top: 2px solid var(--outline-variant);
      border-radius: var(--rounded);
      text-align: left;
      cursor: pointer;
      color: var(--on-surface);
      transition: background-color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
    }

    .celebration-tab:hover {
      background-color: var(--surface-container);
      border-top-color: var(--outline);
    }

    .celebration-tab[aria-selected="true"] {
      background-color: var(--primary-container);
      border-color: var(--primary);
      border-top: 3px solid var(--outline);
      box-shadow: var(--leaf-underline);
    }

    .celebration-tab.is-hidden {
      display: none;
    }

    .tab-meta-row {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-xs);
    }

    .tab-num {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      font-variant-numeric: tabular-nums lining-nums;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--tertiary);
    }

    .celebration-tab[aria-selected="true"] .tab-num {
      color: var(--primary);
    }

    .tab-done-mark {
      color: var(--secondary);
      display: inline-flex;
      align-items: center;
    }

    .tab-title {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 0.9375rem;
      line-height: 1.2;
      color: var(--on-surface);
    }

    .tab-guide {
      font-size: 0.75rem;
      color: var(--on-surface-variant);
      line-height: 1.3;
    }

    /* Active Celebration Detail Workspace */
    .celebration-hero-card {
      background-color: var(--surface-container-low);
      border-top: var(--brass-rule);
      box-shadow: var(--leaf-underline);
      border-radius: var(--rounded-lg);
      padding: var(--space-lg) var(--space-xl);
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    .celebration-badges-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
    }

    .badge-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm);
    }

    .stamp-tag {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-xs) var(--space-sm);
      border: 1px solid var(--outline);
      border-radius: var(--rounded);
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--tertiary);
      background-color: transparent;
    }

    .stamp-tag-green {
      border-color: var(--secondary);
      color: var(--secondary);
      background-color: var(--secondary-container);
    }

    .celebration-heading {
      font-family: var(--font-headline);
      font-weight: 400;
      font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.25rem);
      line-height: 1.12;
      margin: 0;
      color: var(--on-surface);
    }

    .celebration-subtitle {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: var(--subhead-size);
      color: var(--primary);
      margin: 0;
      line-height: 1.35;
    }

    .celebration-intro-box {
      border-left: 3px solid var(--outline);
      padding: var(--space-sm) var(--space-md);
      background-color: var(--background);
      max-width: 70ch;
    }

    .celebration-intro-label {
      display: block;
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--tertiary);
      margin-bottom: var(--space-xs);
    }

    .celebration-intro-text {
      margin: 0;
      font-family: var(--font-headline);
      font-style: italic;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--on-surface);
    }

    /* Two-column asymmetric workspace (Charter house layout) */
    .workspace-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: start;
    }

    .column-stack {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    /* Figure Cards (Charter Treatment 3 & 4) */
    .figure-card {
      background-color: var(--surface-container-low);
      border-top: var(--brass-rule);
      box-shadow: var(--leaf-underline);
      border-radius: var(--rounded-lg);
      padding: var(--space-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .card-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
      border-bottom: var(--hairline);
      padding-bottom: var(--space-sm);
    }

    .card-kicker {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--on-surface-variant);
    }

    .figure-value {
      font-family: var(--font-headline);
      font-weight: 400;
      font-size: clamp(1.375rem, 1.15rem + 0.65vw, 1.75rem);
      font-variant-numeric: tabular-nums lining-nums;
      color: var(--primary);
      line-height: 1.25;
      margin: var(--space-xs) 0 0;
    }

    .figure-delta {
      color: var(--tertiary);
      font-size: 0.875rem;
      font-weight: 600;
      margin: 0;
    }

    .card-body-text {
      margin: 0;
      color: var(--on-surface);
      max-width: 65ch;
      line-height: 1.65;
    }

    .gesture-action-bar {
      margin-top: var(--space-sm);
      padding-top: var(--space-md);
      border-top: var(--hairline);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
    }

    .status-note {
      font-size: 0.875rem;
      color: var(--on-surface-variant);
    }

    .status-note.is-positive {
      color: var(--secondary);
      font-weight: 600;
    }

    /* Prayer & Sign Panel */
    .prayer-text {
      font-family: var(--font-headline);
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--on-surface);
      margin: 0;
      max-width: 62ch;
    }

    .sign-callout {
      background-color: var(--background);
      border: var(--hairline);
      border-left: 2px solid var(--secondary);
      padding: var(--space-md);
      border-radius: var(--rounded);
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .sign-title {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1rem;
      color: var(--secondary);
      margin: 0;
    }

    .prayer-empty-note {
      background-color: var(--background);
      border: var(--hairline);
      padding: var(--space-md);
      border-radius: var(--rounded);
      color: var(--on-surface-variant);
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    /* Form Controls (always-visible label above input) */
    .field-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .field-label {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--on-surface-variant);
    }

    .text-input, .textarea-input {
      width: 100%;
      background-color: var(--surface-container-low);
      border: 1px solid var(--outline-variant);
      border-radius: var(--rounded);
      padding: var(--space-sm) var(--space-md);
      color: var(--on-surface);
      font-size: 0.9375rem;
      line-height: 1.5;
      transition: border-color var(--dur-micro) var(--ease-out);
    }

    .text-input:focus, .textarea-input:focus {
      border-color: var(--primary);
      outline: 2px solid var(--focus);
      outline-offset: 1px;
    }

    .textarea-input {
      min-height: 92px;
      resize: vertical;
    }

    .controls-row-aligned {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-md);
    }

    .search-box-wrap {
      flex: 1 1 260px;
      max-width: 380px;
    }

    .inline-feedback {
      font-size: 0.875rem;
      color: var(--secondary);
      font-weight: 500;
      min-height: 1.25rem;
    }

    /* Overview Table (Charter native habitat) */
    .table-scroll {
      width: 100%;
      overflow-x: auto;
      background-color: var(--surface-container-low);
      border-top: var(--brass-rule);
      box-shadow: var(--leaf-underline);
      border-radius: var(--rounded);
    }

    .campaign-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9375rem;
    }

    .campaign-table thead th {
      background-color: var(--surface-container-high);
      color: var(--on-surface);
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: var(--space-sm) var(--space-md);
      border-bottom: var(--brass-rule);
      white-space: nowrap;
    }

    .campaign-table tbody td {
      padding: var(--space-md);
      border-bottom: var(--hairline);
      vertical-align: top;
      color: var(--on-surface);
    }

    .campaign-table tbody tr {
      cursor: pointer;
      transition: background-color var(--dur-micro) var(--ease-out);
    }

    .campaign-table tbody tr:hover {
      background-color: var(--surface-container);
    }

    .campaign-table tbody tr.is-selected {
      background-color: var(--primary-container);
    }

    .col-num {
      font-variant-numeric: tabular-nums lining-nums;
      font-weight: 600;
      color: var(--tertiary);
      white-space: nowrap;
    }

    .table-title-cell {
      font-family: var(--font-headline);
      font-weight: 700;
      color: var(--primary);
    }

    .table-scripture-cell {
